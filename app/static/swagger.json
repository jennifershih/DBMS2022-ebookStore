        "tags": ["User"],
        "summary": "註冊新使用者",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "要新增到系統的使用者物件，role有admin、user兩種",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "使用者建立成功"
          },
          "400": {
            "description": "使用者已存在"
          }
        }
